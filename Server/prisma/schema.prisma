// ─────────────────────────────────────────────────────
//  Prisma Schema — Huellas (Better Auth + Business)
// ─────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── 1. BETTER AUTH — MODELOS DEL SISTEMA ────────────
// Estos modelos son requeridos por Better Auth para
// gestionar autenticación, sesiones y cuentas OAuth.

model User {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  emailVerified  Boolean    @default(false)
  image          String?
  // ── Custom fields de la aplicación ──
  contact        String
  contactType    String                        // ContactType enum: "WhatsApp" | "Telegram" | "Instagram" | "Discord" | "Facebook"
  profilePictureUrl String?
  // ── Relaciones ──
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions       Session[]
  accounts       Account[]
  posts          Post[]
  favorites      Favorite[]

  @@unique([contact, contactType])              // No duplicar contacto+tipo entre usuarios
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── 2. MODELOS DE NEGOCIO ───────────────────────────

model Post {
  id          String   @id @default(uuid())
  userId      String
  // ── Datos de la mascota ──
  name        String                        // Nombre de la mascota
  age         Int
  unidadTiempo String                       @default("años")
  weight      Float
  size        String                        // "small" | "medium" | "large"
  category    String                        // "dog" | "cat" | etc.
  gender      String                        // "male" | "female"
  neutered    Boolean
  // ── Geolocalización ──
  latitude    Float
  longitude   Float
  location    String                        // Descripción textual (ej: "Parque Centenario, CABA")
  placeId     String?
  // ── Opcionales ──
  birthDate   DateTime?
  description String?
  photosUrl   String[]                      // Array de URLs (Cloudinary / externo)
  // ── Timestamps ──
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // ── Relaciones ──
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  favorites   Favorite[]
  clinicalHistory ClinicalHistoryItem[]

  @@index([userId])
  @@index([category])
  @@index([size])
  @@index([latitude, longitude])            // Índice compuesto para búsquedas geográficas
}

model Favorite {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])                // Un usuario solo puede marcar una vez
  @@index([userId])
  @@index([postId])
}

enum ClinicalHistoryType {
  VACUNACION
  DESPARASITACION
  CHEQUEO_PREVENTIVO
  OTRO
}

model ClinicalHistoryItem {
  id           String              @id @default(uuid())
  postId       String
  type         ClinicalHistoryType
  name         String              @default("")
  date         DateTime
  veterinary   String
  veterinarian String
  comprobante  String              // File path or URL
  description  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  post         Post                @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

