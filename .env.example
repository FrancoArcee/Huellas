# ─── Backend (Server) ───────────────────────────────
# Dev local: postgresql://app:app@localhost:5432/petapp?schema=public
# Producción (Neon): usá el connection string "pooled" que te da el dashboard
DATABASE_URL=postgresql://app:app@localhost:5432/petapp?schema=public

# Secreto aleatorio largo (en Render se genera solo con generateValue)
BETTER_AUTH_SECRET=change-me

# Dev local: http://localhost:3000
# Producción: https://<tu-servicio>.onrender.com
BETTER_AUTH_URL=http://localhost:3000

# ─── Mobile (Expo) ──────────────────────────────────
# Dev local: http://localhost:3000 (se reemplaza por la IP de Metro en físico)
# Producción: https://<tu-servicio>.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:3000
