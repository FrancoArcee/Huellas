{
  "expo": {
    "name": "Huellas",
    "slug": "huellas",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "huellas",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.huellas.app"
    },
    "android": {
      "package": "com.huellas.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCK2JkdV-5h2s2iypSB-Lbs51k3jYuYbrs"
        }
      },
      "icon": "./src/assets/images/logo.png",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logo.png",
        "backgroundColor": "#F1EEEE"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Huellas usa tu ubicación para encontrar mascotas cercanas y completar direcciones."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "52d0c0fa-3e2b-44c5-91d6-01da0b6cd5d7"
      }
    }
  }
}